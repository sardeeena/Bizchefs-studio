# ====================================================================
# BizChefs Studio — Minimal Required Environment Variables
# Application: studio.bizchefs.com
# All server secrets must NEVER be prefixed with NEXT_PUBLIC_
# ====================================================================

# 1. Application URL
APP_URL="https://studio.bizchefs.com"

# 2. Supabase (Database & Authentication)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# 3. Google Integrations (GA4 & Search Console OAuth)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="https://studio.bizchefs.com/api/integrations/google/callback"

# 4. Token Encryption Key (AES-256-GCM)
# Generate via: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY="your-64-character-hex-encryption-key"

# 5. Hostinger REST API Integration
# Obtain from: Hostinger hPanel -> Account -> API Tokens
HOSTINGER_API_TOKEN="your-hostinger-api-token"

# 6. AI Studio / Gemini API (Server-Side Only)
GEMINI_API_KEY="your-gemini-api-key"
