# BizChefs Studio — Client Portal Environment Configuration Blueprint
# Note: Do not put production secrets in version control.

# Application URL
APP_URL="https://studio.bizchefs.com"

# Server-Side Session Signing Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET="CHANGE_ME_SECRET_AT_LEAST_32_CHARACTERS"

# PostgreSQL Relational Database URL (Tenant data model)
DATABASE_URL="postgresql://bizchefs_studio:secure_password@localhost:5432/bizchefs_studio?sslmode=require"

# Hostinger Official REST API Integration
# Docs: https://developers.hostinger.com/
# Generate personal access token from Hostinger hPanel -> API Tokens
HOSTINGER_API_TOKEN="YOUR_HOSTINGER_API_TOKEN"

# Google Analytics 4 & Search Console Integration
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLOUD_OAUTH_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLOUD_OAUTH_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://studio.bizchefs.com/api/auth/google/callback"

# Gemini AI (Server-Side Proxy Route only, if AI insights requested)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
